{
  "name": "@citisen/litearea",
  "version": "0.2.1",
  "description": "A lightweight textarea-based code editor: native undo/redo, fully custom syntax highlighting, VSCode-style completion, diagnostics, and hover tooltips. No CodeMirror, no Monaco.",
  "type": "module",
  "license": "MIT",
  "author": "citisen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/citisen/litearea.git"
  },
  "homepage": "https://github.com/citisen/litearea#readme",
  "bugs": {
    "url": "https://github.com/citisen/litearea/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/types/react/index.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "src",
    "scripts",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node scripts/build-css.mjs",
    "watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "browser": "node scripts/browser-check.mjs",
    "demo": "vite --config examples/demo/vite.config.ts",
    "demo:build": "vite build --config examples/demo/vite.config.ts",
    "verify": "node scripts/verify-package.mjs",
    "check": "npm run typecheck && npm run build && npm run test && npm run verify && npm run browser",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "keywords": [
    "textarea",
    "editor",
    "code-editor",
    "syntax-highlighting",
    "semantic-highlighting",
    "autocomplete",
    "intellisense",
    "diagnostics",
    "tooltip",
    "hover",
    "undo",
    "redo",
    "dsl",
    "lightweight",
    "zero-dependency",
    "react"
  ],
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
