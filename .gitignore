# The toolchain's own install. Nothing here is shipped: `dist/` is built from
# `src/` by `npm run build`, and the published tarball carries the built output
# plus the sources it came from.
node_modules/

# Build output. Deliberately NOT committed, unlike a DSH plugin's `lib/`: this
# is a plain library, so the registry tarball is the artifact that matters and a
# committed copy would only be one more thing to keep in step.
dist/
coverage/

# The demo's own build, which `npm run demo:build` writes.
examples/demo/dist/

# The documentation site. `site/pages/**/*.html` is GENERATED by `site/build.mjs` from the
# markdown in `site/content/` and the reference files in `docs/`, and it is the Vite root —
# what is committed is the source and the hand-written assets beside it, never the output.
# Everything the build writes into `pages/public/` is generated too — the search index, the
# markdown mirrors, `llms.txt` — so that directory is ignored EXCEPT the fonts, which are
# checked in because they are the one thing in it that is not derived from anything here.
site/pages/**/*.html
site/pages/public/*
!site/pages/public/fonts/
site/dist/
site/.tmp/

# npm pack output
*.tgz

# Editor and OS noise
.DS_Store
Thumbs.db
*.log
